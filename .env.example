# ============================================================
# Lyrica API — Environment Variables (Public Repo Version)
# ============================================================
# Copy this file to '.env' and fill in your details.
# Do NOT commit '.env' or any files containing credentials.
# ============================================================

# Secure admin key to protect administrative endpoints.
# Required for proxy rotation and config hot-reload endpoints.
ADMIN_KEY=your_secure_admin_key_here

# ── API Tokens (Optional) ────────────────────────────────────
# Genius API token — gets plain text lyrics (source 1)
# Register at: https://genius.com/api-clients
GENIUS_TOKEN=

# Musixmatch token — gets synced LRC lyrics (source 6)
# Register at: https://developer.musixmatch.com/
MUSIXMATCH_TOKEN=

# Apple Music Developer Token — gets syllable/word synced lyrics (source 8)
# Requires an Apple Music Developer account.
# Generate a JWT here: https://developer.apple.com/
# Env var aliases: APPLE_MUSIC_DEVELOPER_TOKEN or DEVELOPER_TOKEN
APPLE_MUSIC_DEVELOPER_TOKEN=
#
# Apple Music User Token (required for some API endpoints)
# Env var aliases: APPLE_MUSIC_USER_TOKEN or MUSIC_USER_TOKEN
APPLE_MUSIC_USER_TOKEN=
# Apple Music Storefront (default: us)
APPLE_STOREFRONT=us
# Preferred lyrics language (default: en)
APPLE_LYRICS_LANGUAGE=en
# Preferred lyrics script (default: latin)
APPLE_LYRICS_SCRIPT=latin

# ── YouTube Proxy (Optional) ─────────────────────────────────
# Route YouTube fetcher layers (transcript-api, yt-dlp) through
# a rotating proxy to avoid rate limits / IP bans.
#
# Option A — full URL (recommended):
# YT_PROXY_URL=http://username:password@host:port
#
# Option B — individual components:
# YT_PROXY_USER=your-proxy-username
# YT_PROXY_PASS=your-proxy-password
# YT_PROXY_HOST=p.webshare.io
# YT_PROXY_PORT=80
#
# Leave all blank to run without proxy (direct connection).
YT_PROXY_URL=

# ── Global Proxy (Optional) ──────────────────────────────────
# Routes ALL fetchers (lrclib, lrcmux, genius, netease, etc.)
# through a proxy. Supports a single URL or comma-separated list.
#
# Example: PROXY_URL=http://user:pass@host:port
# Multiple: PROXY_URL=http://user:pass@host1:port,http://user:pass@host2:port
PROXY_URL=

# ── YouTube Music Auth (Optional) ────────────────────────────
# Provide explicit paths to auth files for hosted/containerised deployments.
# If not set, Lyrica scans the project root and cwd automatically.
#
# Path to headers_auth.json (ytmusicapi browser auth — enables richer lyrics):
YT_HEADERS_PATH=
#
# Path to cookies.txt (Netscape format — used by yt-dlp Layer 3):
YT_COOKIES_PATH=
#
# Alternatively, place either file in the project root (they're in .gitignore).

# ── Redis Cache & Rate Limiting (Optional) ───────────────────
# Connection string for Redis L2 distributed cache and rate limiting.
# Example: redis://:password@redis-host:6379/0 or redis://localhost:6379/0
# When set, enables multi-tier caching (L1 Memory + L2 Redis + L3 Disk).
REDIS_URL=

# Storage URI for Flask-Limiter. Defaults to REDIS_URL if set, or memory://

# ── Caching & Logs ───────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Cache TTL (time-to-live) in seconds
CACHE_TTL=86400

# Directory where cache JSON files are stored (L3 disk fallback)
CACHE_DIR=cache_data

# ── Groq AI (Translation & Romanization) ─────────────────────
# API key(s) for Groq LLM (openai/gpt-oss-120b).
# Get one at: https://console.groq.com/
#
# Single key:
#   GROQ_API_KEY=gsk_abc123
#
# Multiple keys (enables automatic load balancing & failover):
#   GROQ_API_KEY=gsk_abc123,gsk_def456,gsk_ghi789
#
# If a key fails with auth error, it's quarantined for 24 hours.
# Rate-limited keys get a 60-second cooldown.
GROQ_API_KEY=

# Override the default Groq model (default: openai/gpt-oss-120b):
# GROQ_MODEL=openai/gpt-oss-120b

