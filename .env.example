# ============================================================
# Lyrica API — Environment Variables (Public Repo Version)
# ============================================================
# Copy this file to '.env' and fill in your details.
# Do NOT commit '.env' or any files containing credentials.
# ============================================================

# Secure admin key to protect administrative endpoints.
# Required for proxy rotation and config hot-reload endpoints.
ADMIN_KEY=your_secure_admin_key_here

# ── API Tokens (Optional) ────────────────────────────────────
# Genius API token — gets plain text lyrics (source 1)
# Register at: https://genius.com/api-clients
GENIUS_TOKEN=

# Musixmatch token — required to load source 6
# Register at: https://developer.musixmatch.com/
MUSIXMATCH_TOKEN=

# Apple Music Developer Token — required to load source 8
# Enables syllable/word synced lyrics.
# Requires an Apple Music Developer account.
# Generate a JWT here: https://developer.apple.com/
# Env var aliases: APPLE_MUSIC_DEVELOPER_TOKEN or DEVELOPER_TOKEN
APPLE_MUSIC_DEVELOPER_TOKEN=
#
# Apple Music User Token (required for some API endpoints)
# Env var aliases: APPLE_MUSIC_USER_TOKEN or MUSIC_USER_TOKEN
APPLE_MUSIC_USER_TOKEN=
# Apple Music Storefront (default: us)
APPLE_STOREFRONT=us
# Preferred lyrics language (default: en)
APPLE_LYRICS_LANGUAGE=en
# Preferred lyrics script (default: latin)
APPLE_LYRICS_SCRIPT=latin

# ── YouTube Proxy (Reserved) ─────────────────────────────────
# YouTube Music is temporarily disabled while its fetcher is rebuilt.
# These settings are reserved for the rebuilt fetcher.
#
# Option A — full URL (recommended):
# YT_PROXY_URL=http://username:password@host:port
#
# Option B — individual components:
# YT_PROXY_USER=your-proxy-username
# YT_PROXY_PASS=your-proxy-password
# YT_PROXY_HOST=p.webshare.io
# YT_PROXY_PORT=80
#
# Leave all blank to run without proxy (direct connection).
YT_PROXY_URL=

# ── Global Proxy (Optional) ──────────────────────────────────
# Routes ALL fetchers (lrclib, lrcmux, genius, netease, etc.)
# through a proxy. Supports a single URL or comma-separated list.
#
# Example: PROXY_URL=http://user:pass@host:port
# Multiple: PROXY_URL=http://user:pass@host1:port,http://user:pass@host2:port
PROXY_URL=

# ── YouTube Music Auth (Reserved) ────────────────────────────
# YouTube Music is temporarily disabled while its fetcher is rebuilt.
# Provide explicit paths to auth files for the rebuilt fetcher.
#
# Path to headers_auth.json (ytmusicapi browser auth — enables richer lyrics):
YT_HEADERS_PATH=
#
# Path to cookies.txt (Netscape format — used by yt-dlp Layer 3):
YT_COOKIES_PATH=
#
# Alternatively, place either file in the project root (they're in .gitignore).

# ── Redis Cache & Rate Limiting (Optional) ───────────────────
# Connection string for Redis L2 distributed cache and rate limiting.
# Example: redis://:password@redis-host:6379/0 or redis://localhost:6379/0
# When set, enables multi-tier caching (L1 Memory + L2 Redis + L3 Disk).
REDIS_URL=

# Storage URI for Flask-Limiter. Defaults to REDIS_URL if set, or memory://
# Use a Redis DB separate from the cache (e.g. redis://host:6379/1) so cache
# eviction does not delete rate-limit counters.
RATE_LIMIT_STORAGE_URI=

# Default request limit applied to every endpoint (Flask-Limiter syntax).
# Production default when unset: 60 per minute.
RATE_LIMIT_DEFAULT=60 per minute

# ── HTTP / Proxy / Limits ────────────────────────────────────
# Comma-separated browser origins allowed in production. "*" allows all.
CORS_ORIGINS=*

# Number of trusted reverse-proxy hops (X-Forwarded-For). Set to 1 behind
# nginx/Traefik/Render/Railway so rate limiting sees the real client IP.
TRUST_PROXY=0

# Maximum request body size in bytes (admin JSON endpoints). Default 1 MiB.
MAX_CONTENT_LENGTH=1048576

# Maximum length of artist/song/query text fields. Default 200.
MAX_TEXT_LENGTH=200

# ── Caching & Logs ───────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Cache TTL (time-to-live) in seconds
CACHE_TTL=86400

# Directory where cache JSON files are stored (L3 disk fallback)
CACHE_DIR=cache_data

# Metadata (MusicBrainz/iTunes/Last.fm/Wikipedia) cache TTL and max entries.
METADATA_CACHE_TTL=3600
METADATA_CACHE_MAX=2000

# Browser cache lifetime for static assets (/static, /app template assets).
STATIC_CACHE_SECONDS=3600

# ── v2 reliability & performance ─────────────────────────────
# Optional gzip/brotli. Off by default: Lyrica ships lean payloads and leaves
# compression to your reverse proxy. Set to true to enable flask-compress.
LYRICA_COMPRESS=false

# How long a confirmed "not found" is remembered, in seconds. Provider errors
# and rejected wrong-song results are never negative-cached.
LYRICA_NEGATIVE_TTL=3600
LYRICA_NEGATIVE_MAX=5000

# Provider circuit breaker: open after N consecutive transport failures, wait
# this many seconds, then require this many good probes before closing.
LYRICA_BREAKER_THRESHOLD=5
LYRICA_BREAKER_COOLDOWN=30
LYRICA_BREAKER_GOOD_PROBES=2

# Max in-flight calls per provider per event loop.
LYRICA_PROVIDER_CONCURRENCY=8

# Comma-separated providers to disable entirely (e.g. genius,apple_music).
# LYRICA_DISABLED_PROVIDERS=

# Optional trusted client keys. Requests with a matching X-API-Key get their
# own rate-limit bucket (keyed by a hash, never the raw secret); everyone else
# is limited by IP. Unknown keys are ignored so they cannot bypass the limit.
# LYRICA_API_KEYS=client_key_one,client_key_two

# Per-provider RPM overrides. Values in .lyrica.config [rate_limits] are used
# by default; these env vars win when set.
# LYRICA_PROVIDER_LRCLIB_RPM=30
# LYRICA_PROVIDER_GENIUS_RPM=5

# ── Groq AI (Translation & Romanization) ─────────────────────
# API key(s) for Groq LLM (openai/gpt-oss-120b).
# Get one at: https://console.groq.com/
#
# Single key:
#   GROQ_API_KEY=gsk_abc123
#
# Multiple keys (enables automatic load balancing & failover):
#   GROQ_API_KEY=gsk_abc123,gsk_def456,gsk_ghi789
#
# If a key fails with auth error, it's quarantined for 24 hours.
# Rate-limited keys get a 60-second cooldown.
GROQ_API_KEY=

# Override the default Groq model (default: openai/gpt-oss-120b):
# GROQ_MODEL=openai/gpt-oss-120b

