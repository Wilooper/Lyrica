# ============================================================
# Lyrica MCP Server - Environment Variables
# Copy to `.env` in this directory (or export in your shell).
# ============================================================

# Base URL of the running Lyrica v1.5.0 API.
# Local Python:  http://127.0.0.1:9999
# Docker:        http://localhost:7860
# Remote:        https://your-lyrica-host.example.com
LYRICA_API_URL=http://127.0.0.1:9999

# HTTP timeout in seconds (1-600). Translation requests get at least 180s.
LYRICA_TIMEOUT=90

# MCP transport: stdio or streamable-http.
LYRICA_MCP_TRANSPORT=stdio

# Streamable HTTP settings (ignored for stdio).
LYRICA_MCP_HOST=127.0.0.1
LYRICA_MCP_PORT=8000
LYRICA_MCP_PATH=/mcp
LYRICA_MCP_JSON_RESPONSE=false

# DEBUG, INFO, WARNING, ERROR, or CRITICAL. Logs always go to stderr.
LYRICA_MCP_LOG_LEVEL=INFO
